<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<title>Zeynep & Berkan Nişan Davetiyesi</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Great+Vibes&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  font-family: 'Playfair Display', serif;
  background: #f5efe6;
  color: #4b3f35;
}

/* ÜST ALAN */
.hero {
  text-align: center;
  padding: 110px 20px 70px 20px;
  background:
  linear-gradient(rgba(245,239,230,0.85), rgba(245,239,230,0.85)),
  url('https://images.unsplash.com/photo-1520854221256-17451cc331bf');
  background-size: cover;
  background-position: center;
}

.save {
  letter-spacing: 4px;
  font-size: 14px;
  opacity: 0.7;
}

.names {
  font-family: 'Great Vibes', cursive;
  font-size: 72px;
  color: #3e332a;
  margin: 10px 0;
}

.line {
  width: 120px;
  height: 2px;
  background: #c8a96a;
  margin: 20px auto;
}

/* DAVET METNİ */
.invite-text {
  text-align: center;
  max-width: 500px;
  margin: 40px auto 10px auto;
  font-size: 17px;
  line-height: 1.7;
  opacity: 0.85;
}

/* TARİH SAAT KARTI */
.date-card {
  background: #fffaf3;
  padding: 45px 30px;
  border-radius: 25px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.07);
  max-width: 420px;
  margin: 30px auto;
  text-align: center;
  border: 1px solid #e7d9c5;
}

.date {
  font-size: 22px;
  letter-spacing: 2px;
}

.time {
  font-size: 36px;
  margin: 10px 0;
  font-weight: bold;
}

.mini-line {
  width: 60px;
  height: 2px;
  background: #c8a96a;
  margin: 15px auto;
}

/* ADRES */
.address {
  text-align: center;
  margin-top: 10px;
  font-size: 16px;
  opacity: 0.85;
}

/* HARİTA */
.map {
  text-align: center;
  padding: 40px 20px 80px 20px;
}

.map iframe {
  width: 90%;
  height: 380px;
  border: 0;
  border-radius: 18px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

/* MOBİL */
@media(max-width:600px){
  .names {font-size: 48px;}
}
</style>
</head>

<body>

<!-- AÇILIŞ -->
<div class="hero">
  <p class="save">SAVE THE DATE</p>
  <div class="names">Zeynep & Berkan</div>
  <div class="line"></div>
</div>

<!-- DAVET METNİ -->
<p class="invite-text">
Bu özel günümüzde sizleri aramızda görmekten mutluluk duyarız…
</p>

<!-- TARİH SAAT -->
<div class="date-card">
  <div class="date">14 ŞUBAT | CUMARTESİ</div>
  <div class="time">13:00</div>
  <div class="mini-line"></div>
  <div>Nişan Töreni</div>
</div>

<!-- ADRES -->
<div class="address">
  <p><b>Bal Event</b></p>
  <p>Mermeroğlu Cd. No:61 D:5</p>
  <p>Bağlıca – Etimesgut</p>
</div>

<!-- HARİTA -->
<div class="map">
  <iframe src="https://www.google.com/maps?q=Bağlıca Etimesgut&output=embed"></iframe>
</div>

</body>
</html>